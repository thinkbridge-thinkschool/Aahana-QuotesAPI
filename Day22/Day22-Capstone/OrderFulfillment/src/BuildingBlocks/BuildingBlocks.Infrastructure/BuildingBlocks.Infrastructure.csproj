<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BuildingBlocks.Application\BuildingBlocks.Application.csproj" />
    <ProjectReference Include="..\BuildingBlocks.Domain\BuildingBlocks.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <!-- Day 25: real Service Bus wiring, always authenticated via a TokenCredential
         (DefaultAzureCredential in Program.cs) — never a connection string. -->
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.20.2" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Day 32: a regression test for AzureServiceBusMessageBus.ShortEventTypeName lives in the
         integration test project (it already references OrderFulfillment.Api, which references
         this project transitively) rather than pulling in a new test project just for one method. -->
    <InternalsVisibleTo Include="OrderFulfillment.Api.IntegrationTests" />
  </ItemGroup>

</Project>
